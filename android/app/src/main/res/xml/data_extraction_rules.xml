<?xml version="1.0" encoding="utf-8"?>
<!--
  Android data-extraction rules (API 31+).
  Controls what is included in device-to-device transfers and cloud backups.
  API keys stored by flutter_secure_storage are excluded; note data is included.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="grepink.db" />
        <exclude domain="sharedpref" path="FlutterSecureStorage" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="grepink.db" />
        <exclude domain="sharedpref" path="FlutterSecureStorage" />
    </device-transfer>
</data-extraction-rules>
