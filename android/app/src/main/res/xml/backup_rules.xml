<?xml version="1.0" encoding="utf-8"?>
<!--
  Android Auto Backup rules (API 23+).
  grepink.db is explicitly included so note data survives device transfers and
  factory resets. Manual JSON export (Settings → Export notes) remains the
  recommended immediate recovery method.
-->
<full-backup-content>
    <include domain="database" path="grepink.db" />
    <include domain="database" path="grepink.db-wal" />
    <include domain="database" path="grepink.db-shm" />
    <exclude domain="sharedpref" path="FlutterSecureStorage" />
</full-backup-content>
